# Velen Official Environment Configuration (Template)
PORT=3000

# Secret Key required in the link to reveal and open the admin portal
# Example URL to open admin: https://yourdomain.com/admin?key=velen-adm-sec-962
ADMIN_SECRET_KEY=velen-adm-sec-962

# Master Passcode / PIN to unlock the control room
ADMIN_PASSCODE=2026

# Domains configuration (Optional):
# STORE_DOMAIN: Set to your public store domain (e.g. velen.com) - on this domain, /admin is 100% blocked with 404
# ADMIN_DOMAIN: Set to your admin domain (e.g. admin.velen.com) - opens admin directly when secret key is provided
STORE_DOMAIN=
ADMIN_DOMAIN=
